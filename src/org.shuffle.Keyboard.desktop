[Desktop Entry]
Name=Shuffle Keyboard
Comment=Touch keyboard and precision surface for Plasma
Exec=shuffle-keyboard
Type=Application
X-KDE-Wayland-VirtualKeyboard=true
Icon=input-keyboard-virtual
NoDisplay=true
