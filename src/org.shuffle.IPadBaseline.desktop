[Desktop Entry]
Name=iPad Layout Baseline
Comment=Four-row iPad keyboard geometry reference for Plasma
Exec=env SHUFFLE_KEYBOARD_LAYOUT=ipad shuffle-keyboard
Type=Application
X-KDE-Wayland-VirtualKeyboard=true
Icon=input-keyboard-virtual
NoDisplay=true
